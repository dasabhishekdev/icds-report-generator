# Copied to .env on the VPS by scripts/deploy.sh (with a random password) if .env is missing.
MONGO_ROOT_USER=icds
# Hex only — it is embedded in the MongoDB connection URL.
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-hex-string
# Session cookies require HTTPS; set false only for local http://localhost testing.
COOKIE_SECURE=true
# Set false to stop new sign-ups (existing users can still log in).
ALLOW_REGISTRATION=true
