{
  "name": "icds-report-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Daily attendance, ration calculation and the monthly ICDS registers (Excel and PDF) for Anganwadi centres.",
  "license": "MIT",
  "author": "Abhishek Das (Educoreva) <abhishekdas_dev@outlook.com>",
  "homepage": "https://icds.educoreva.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasabhishekdev/icds-report-generator.git"
  },
  "bugs": {
    "url": "https://github.com/dasabhishekdev/icds-report-generator/issues"
  },
  "keywords": [
    "icds",
    "anganwadi",
    "poshan",
    "west-bengal",
    "reports",
    "pwa",
    "react",
    "fastify",
    "mongodb"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/index.cjs --external:kerberos --external:@mongodb-js/zstd --external:@aws-sdk/credential-providers --external:gcp-metadata --external:snappy --external:socks --external:aws4 --external:mongodb-client-encryption",
    "start": "node dist-server/index.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.64.0",
    "mongodb": "^7.7.0",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
